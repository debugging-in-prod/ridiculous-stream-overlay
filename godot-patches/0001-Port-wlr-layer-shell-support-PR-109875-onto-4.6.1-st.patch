+int WaylandThread::window_get_wayland_layer(DisplayServer::WindowID p_window_id) const {
+	ERR_FAIL_COND_V(!windows.has(p_window_id), 0);
+	const WindowState &ws = windows[p_window_id];
+	return ws.wayland_layer;
+}
