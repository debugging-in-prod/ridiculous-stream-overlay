# Nivek overlay relay config. Copy this file to `nivek_relay.env` (which is
# gitignored) and paste your minted device token below. RSNivekRelay reads it at
# startup; an OS environment variable of the same name wins over this file.
#
#   cp nivek_relay.env.example nivek_relay.env
#
# The device token is shown only once when you mint it from the nivek dashboard
# (POST /api/overlay/device). Treat it like a password.

NIVEK_DEVICE_TOKEN=

# Optional. Defaults to wss://peanutbudderbot.com/api/overlay/connect if unset.
# NIVEK_RELAY_URL=wss://peanutbudderbot.com/api/overlay/connect
